# Leave LLM_* empty to run in retrieval-only mode (returns the top matching chunks).
# Any OpenAI-compatible provider works. Check your provider for current model names.

# Option A: Groq (free tier)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# Option B: Ollama (local, no key)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:3b

# Optional tuning
# EMBED_MODEL=intfloat/multilingual-e5-small
# CHUNK_WORDS=200
# CHUNK_OVERLAP=40
# TOP_K=4
